# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ggc_assessment?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_secure_random_32_char_string_here"
# Optional: Interval revalidasi token JWT ke database dalam detik (Phase 2.5: default 300 = 5 menit)
AUTH_TOKEN_REVALIDATION_SECONDS="300"

# Initial admin account created by `npm run prisma:seed` (password minimal 12 karakter).
# Tidak ada akun demo bawaan; jangan pakai password yang mudah ditebak.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Gmail SMTP Configuration (Nodemailer)
# Gunakan 16-character Google App Password (bukan password akun biasa)
EMAIL_USER="gogreatcareer@gmail.com"
EMAIL_PASS="your-16-char-app-password"

# Midtrans Snap Payment Gateway
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Automated Webhook Rescuer Cron Job (Vercel Cron / External Cron)
CRON_SECRET="your_secure_cron_secret_token_here"

# Transactional ESP (Resend)
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Go Great Career <onboarding@resend.dev>"

# Error Monitoring (Sentry)
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG="go-great-career"
SENTRY_PROJECT="ggc-assessment-system"
