// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AccessCodeStatus {
  AVAILABLE
  USED
}

enum DimensionCategory {
  TALENT
  INTEREST
  PERSONALITY
  VALUES
  ACADEMIC
  CAREER
  READINESS
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password_hash       String
  role                Role                @default(STUDENT)
  is_active           Boolean             @default(true)
  email_verified      Boolean             @default(false)
  token_version       Int                 @default(0)
  created_at          DateTime            @default(now())
  updated_at          DateTime            @updatedAt
  profile             StudentProfile?
  sessions            AssessmentSession[]
  access_codes        AccessCode[]
  verification_tokens VerificationToken[]
  orders              Order[]

  @@map("users")
}

model VerificationToken {
  id         String   @id @default(cuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token])
  @@index([user_id])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id         String   @id @default(cuid())
  email      String
  token      String   @unique
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([token])
  @@index([email])
  @@map("password_reset_tokens")
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  REFUNDED
  CHARGEBACK
}

model Order {
  id                   String               @id @default(cuid())
  order_id             String               @unique
  user_id              String?
  user                 User?                @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name        String
  customer_email       String
  customer_phone       String?
  amount               Int
  status               OrderStatus          @default(PENDING)
  snap_token           String?
  snap_redirect_url    String?
  payment_type         String?
  payment_details      Json?
  created_at           DateTime             @default(now())
  updated_at           DateTime             @updatedAt
  pending_registration PendingRegistration?
  email_outbox         EmailOutbox[]

  @@index([order_id])
  @@index([customer_email])
  @@index([status])
  @@index([user_id])
  @@index([status, created_at])
  @@map("orders")
}

model PendingRegistration {
  id            String   @id @default(cuid())
  order_id      String   @unique
  order         Order    @relation(fields: [order_id], references: [order_id], onDelete: Cascade)
  email         String
  full_name     String
  phone         String?
  password_hash String
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("pending_registrations")
}

model EmailOutbox {
  id              String    @id @default(cuid())
  order_id        String
  order           Order     @relation(fields: [order_id], references: [order_id], onDelete: Restrict)
  user_id         String
  recipient_email String
  idempotency_key String    @unique
  status          String    @default("PENDING") // PENDING, PROCESSING, SENT, EXPIRED, FAILED
  attempts        Int       @default(0)
  last_error      String?
  expires_at      DateTime
  locked_until    DateTime?
  sent_at         DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([status, locked_until])
  @@map("email_outbox")
}

model StudentProfile {
  id                 String   @id @default(uuid())
  user_id            String   @unique
  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  full_name          String
  phone_number       String?
  school_name        String?
  grade              String?
  career_preferences Json?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("student_profiles")
}

model Question {
  id                 String             @id @default(uuid())
  code               String             @unique // e.g. T01..T12, I01..I12, P01..P12, V01..V12, A01..A12, C01..C12, R01..R12
  dimension_category DimensionCategory
  subdimensi         String             // e.g. Analytical, Realistic, Investigative, etc.
  question_text      String
  options            Json?              // Optional custom options or standard 1-5 scale descriptor
  is_active          Boolean            @default(true)
  created_at         DateTime           @default(now())
  updated_at         DateTime           @updatedAt
  answers            AssessmentAnswer[]

  @@index([dimension_category])
  @@index([code])
  @@map("questions")
}

model QuestionSet {
  id             String              @id @default(cuid())
  version        Int                 @unique
  title          String
  is_active      Boolean             @default(false)
  scoring_config Json
  published_at   DateTime?
  created_at     DateTime            @default(now())
  items          QuestionSetItem[]
  sessions       AssessmentSession[]

  @@map("question_sets")
}

model QuestionSetItem {
  id                 String             @id @default(cuid())
  question_set_id    String
  question_set       QuestionSet        @relation(fields: [question_set_id], references: [id], onDelete: Restrict)
  code               String
  order_index        Int
  dimension_category DimensionCategory
  subdimensi         String
  question_text      String
  options            Json
  scoring_weight     Float              @default(1.0)
  legacy_question_id String?
  created_at         DateTime           @default(now())
  answers            AssessmentAnswer[]

  @@unique([question_set_id, code])
  @@index([question_set_id, order_index])
  @@map("question_set_items")
}

model AssessmentSession {
  id              String             @id @default(uuid())
  user_id         String
  user            User               @relation(fields: [user_id], references: [id], onDelete: Cascade)
  question_set_id String
  question_set    QuestionSet        @relation(fields: [question_set_id], references: [id], onDelete: Restrict)
  status          SessionStatus      @default(IN_PROGRESS)
  started_at      DateTime           @default(now())
  completed_at    DateTime?
  career_profile  Json?
  result_data     Json?
  answers         AssessmentAnswer[]

  @@index([user_id])
  @@index([status])
  @@index([question_set_id])
  @@map("assessment_sessions")
}

model AssessmentAnswer {
  id                   String            @id @default(uuid())
  session_id           String
  session              AssessmentSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
  question_id          String
  question             Question          @relation(fields: [question_id], references: [id], onDelete: Restrict)
  question_set_item_id String
  question_set_item    QuestionSetItem   @relation(fields: [question_set_item_id], references: [id], onDelete: Restrict)
  selected_value       Int               // 1 to 5 Likert Scale
  answered_at          DateTime          @default(now())

  @@unique([session_id, question_id])
  @@index([session_id])
  @@index([question_id])
  @@index([question_set_item_id])
  @@map("assessment_answers")
}

model RateLimitBucket {
  key        String   @id
  count      Int
  reset_at   DateTime
  updated_at DateTime @updatedAt

  @@map("rate_limit_buckets")
}

model AccessCode {
  id         String           @id @default(cuid())
  code       String           @unique
  status     AccessCodeStatus @default(AVAILABLE)
  used_by    String?
  user       User?            @relation(fields: [used_by], references: [id], onDelete: SetNull)
  created_at DateTime         @default(now())
  used_at    DateTime?

  @@index([status])
  @@index([code])
  @@index([used_by])
  @@map("access_codes")
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  admin_id   String
  action     String
  target_id  String?
  details    Json?
  created_at DateTime @default(now())

  @@index([admin_id])
  @@index([action])
  @@map("admin_audit_logs")
}




